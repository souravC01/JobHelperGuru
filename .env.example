# JobHelperGuru Environment Configuration

# Database: Set DATABASE_URL to your Neon PostgreSQL connection string.
# If left unset, JobHelperGuru automatically uses local SQLite (data/tracker.db).
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xyz-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Object Storage (for storing uploaded resume binaries .pdf/.docx)
# If left unset, files are stored in data/uploads/resumes/
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=jobhelperguru-resumes

# Server port (default: 8000)
PORT=8000
