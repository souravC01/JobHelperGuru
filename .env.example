# JobHelperGuru Environment Configuration

# Database: Set DATABASE_URL to your Neon PostgreSQL connection string.
# If left unset, JobHelperGuru automatically uses local SQLite (data/tracker.db).
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xyz-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Object Storage (for storing uploaded resume binaries .pdf/.docx)
# If left unset, files are stored in data/uploads/resumes/
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=jobhelperguru-resumes

# Server port (default: 8000)
PORT=8000

# Google OAuth 2.0 Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AES-256 Fernet Encryption Key for user API keys at rest
SETTINGS_ENCRYPTION_KEY=generate_with_python_secrets_or_fernet

# JWT Authentication Secret Key
JWT_SECRET_KEY=generate_a_random_64_character_hex_secret

# Allowed CORS Origins (comma-separated, default: http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

