# ==============================================================================
# JobHelperGuru Production Environment Configuration (Render Free Tier)
# ==============================================================================

# 1. Neon PostgreSQL Database
# Use the pooled connection string from your Neon dashboard for optimal connection efficiency.
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xyz-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Application Encryption Key (AES-256 Fernet)
# Used to encrypt sensitive user BYOK API keys (OpenAI, Gemini, etc.) at rest in the database.
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=your_generated_fernet_key_here

# 3. JWT Authentication Secret Key
# Used to cryptographically sign session tokens for authenticated user sessions.
# Generate a secure 64-char key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_key_here

# 4. Allowed CORS Origins
# In production, frontend and backend share the same domain on Render.
# Include your Render URL and localhost for local testing.
ALLOWED_ORIGINS=https://jobhelperguru.onrender.com,http://localhost:5173,http://localhost:8000

# 5. Cloudflare R2 Object Storage (Zero-Cost Resume Binaries)
# S3-compatible zero egress cost object storage for PDF and DOCX files.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=jobhelperguru-resumes

# 6. Google Cloud Identity Services (OAuth 2.0)
# Public Google Client ID used for one-click Google Sign-In.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 7. Port Binding (Render automatically provides $PORT in production, default: 10000 or 8000)
PORT=8000
